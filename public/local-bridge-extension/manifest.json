{
  "manifest_version": 3,
  "name": "THOT OS Fansly Bridge",
  "version": "1.1.3",
  "description": "Creator-scoped THOT OS bridge for signed-in Fansly browser profiles.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "downloads", "debugger"],
  "host_permissions": ["https://fansly.com/*", "https://thot-os-vault-bridge-staging.thot-os.workers.dev/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "THOT OS profile identity", "default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["https://fansly.com/*"], "js": ["fansly-vault.js"], "run_at": "document_idle"}
  ]
}
