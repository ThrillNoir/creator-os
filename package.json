{
  "name": "thot-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "index:library": "node scripts/index-library.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:isolation": "node scripts/check-creator-isolation.mjs",
    "cloudflare:export:adelaide": "node scripts/export-adelaide-d1.mjs",
    "cloudflare:previews:build": "node scripts/build-cloudflare-previews.mjs",
    "cloudflare:previews:upload": "node scripts/upload-cloudflare-previews.mjs",
    "migration:export-target": "node scripts/migration/export-target.mjs",
    "migration:reconcile": "node scripts/migration/reconcile.mjs",
    "migration:plan": "node scripts/migration/plan.mjs",
    "migration:automated-reconcile": "node scripts/migration/automated-reconcile.mjs",
    "service-principals:plan": "node scripts/service-principal-plan.mjs",
    "deployment:preflight": "node scripts/deployment-preflight.mjs",
    "deployment:receipt": "node scripts/deployment-receipt.mjs",
    "deploy": "node scripts/deploy-component.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "verify:cloudflare": "npm --prefix cloudflare/vault-bridge run check && npm --prefix cloudflare/instagram-scheduler run check && npm --prefix cloudflare/reddit-scheduler run check && npm --prefix cloudflare/telegram-bridge run check && npm --prefix cloudflare/telegram-bridge test && npm --prefix cloudflare/thot-os-next run verify",
    "verify": "npm run lint && npm test && npm run db:check && npm run db:isolation && npm run build && npm run verify:cloudflare"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
