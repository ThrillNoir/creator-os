#!/bin/sh
# Wrangler 4.125.0 probes `secret-tool --version`, but Ubuntu's libsecret-tools
# has no --version option. Keep every credential operation on the OS binary.
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  [ -x /usr/bin/secret-tool ] || exit 1
  /usr/bin/secret-tool --help >/dev/null 2>&1
  exit 0
fi
exec /usr/bin/secret-tool "$@"
