# Local Creator OS origin. Change this when using a secure tunnel or hosted URL.
CREATOR_OS_BASE_URL=http://localhost:3000

# Generate each value separately with: openssl rand -base64 32
CREATOR_OS_TOKEN_ENCRYPTION_KEY=
CREATOR_OS_OAUTH_STATE_SECRET=

# One agency Composio project; one auth config per supported toolkit.
COMPOSIO_API_KEY=
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=
COMPOSIO_DROPBOX_AUTH_CONFIG_ID=
COMPOSIO_YOUTUBE_AUTH_CONFIG_ID=
COMPOSIO_TIKTOK_AUTH_CONFIG_ID=
COMPOSIO_TWITTER_AUTH_CONFIG_ID=
COMPOSIO_REDDIT_AUTH_CONFIG_ID=

# Private creator-scoped upload handoff. Treat the tokenised path as a secret.
MYROOMZ_VAULT_UPLOAD_URL=

# Public HTTPS Creator OS origin used for signed, short-lived media delivery.
CREATOR_OS_PUBLIC_MEDIA_BASE_URL=

# Optional Cloudflare staging job gateway. Never commit the token.
CLOUDFLARE_STAGING_GATEWAY_URL=https://creator-os-staging-gateway.thot-os.workers.dev
CLOUDFLARE_STAGING_GATEWAY_TOKEN=

# Shared only between the Cloudflare queue consumer and the private callback route.
# Configure the same value as CREATOR_OS_CALLBACK_TOKEN in the Worker.
CREATOR_OS_AUTOMATION_CALLBACK_TOKEN=

# Optional direct provider credentials.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v23.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CreatorOS/0.1 by your-reddit-username

# Optional X publishing through XQuik. Create the key in XQuik after connecting
# the intended X account there; Creator OS verifies the configured public handle.
XQUIK_API_KEY=
