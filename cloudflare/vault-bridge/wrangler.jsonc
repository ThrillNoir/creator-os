{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thot-os-vault-bridge-staging",
  "account_id": "3e7cfa6efb7a97825f1dc24515410c63",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["COMPOSIO_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thot-os-staging",
      "database_id": "174532e8-5ada-4e30-abba-1276b3540b3f",
      "migrations_dir": "../thot-os-app/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PREVIEWS", "bucket_name": "thot-os-previews-staging" },
    { "binding": "LIBRARY_MEDIA", "bucket_name": "thot-os-library-media-staging" }
  ],
  "queues": {
    "producers": [
      { "binding": "PREVIEW_QUEUE", "queue": "thot-os-preview-staging" }
    ],
    "consumers": [
      {
        "queue": "thot-os-preview-staging",
        "max_batch_size": 3,
        "max_batch_timeout": 2,
        "max_retries": 4,
        "retry_delay": 30,
        "max_concurrency": 2,
        "dead_letter_queue": "thot-os-preview-dlq-staging"
      },
      {
        "queue": "thot-os-preview-dlq-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 1,
        "max_concurrency": 1
      }
    ]
  }
}
