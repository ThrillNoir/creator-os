{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thot-os-staging",
  "account_id": "3e7cfa6efb7a97825f1dc24515410c63",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "thot-os-staging" },
    { "binding": "REDDIT_SCHEDULER", "service": "thot-os-reddit-scheduler-staging" },
    { "binding": "INSTAGRAM_SCHEDULER", "service": "thot-os-instagram-scheduler-staging" },
    { "binding": "TELEGRAM_BRIDGE", "service": "thot-os-telegram-bridge-staging" }
  ],
  "vars": {
    "ACCESS_AUD": "96650f7d7a89fb932d2941213c418198999c22ba3abbb9c3d7d566b4375cb930",
    "ACCESS_JWKS_URL": "https://thot-os.cloudflareaccess.com/cdn-cgi/access/certs",
    "ACCESS_ALLOWED_EMAIL": "connect@thrillnoir.com",
    "APP_BASE_URL": "https://thot-os-staging.thot-os.workers.dev",
    "VAULT_BRIDGE_BASE_URL": "https://thot-os-vault-bridge-staging.thot-os.workers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thot-os-staging",
      "database_id": "174532e8-5ada-4e30-abba-1276b3540b3f",
      "migrations_dir": "../thot-os-app/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "thot-os-media-staging" },
    { "binding": "PREVIEWS", "bucket_name": "thot-os-previews-staging" }
  ]
}
