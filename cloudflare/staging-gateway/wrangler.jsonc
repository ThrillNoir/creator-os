{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-os-staging-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": true,
  "r2_buckets": [
    {
      "binding": "INTAKE",
      "bucket_name": "thot-os-creator-intake-staging"
    },
    {
      "binding": "PACKAGES",
      "bucket_name": "thot-os-creator-packages-staging"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTAKE_QUEUE",
        "queue": "thot-os-intake-staging"
      },
      {
        "binding": "AI_QUEUE",
        "queue": "thot-os-ai-jobs-staging"
      }
    ],
    "consumers": [
      {
        "queue": "thot-os-intake-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "thot-os-failures-staging"
      },
      {
        "queue": "thot-os-ai-jobs-staging",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "thot-os-failures-staging"
      }
    ]
  }
}
