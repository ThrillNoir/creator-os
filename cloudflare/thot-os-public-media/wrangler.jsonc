{
  "$schema": "../thot-os-next/node_modules/wrangler/config-schema.json",
  "name": "thot-os-public-media-staging",
  "account_id": "3e7cfa6efb7a97825f1dc24515410c63",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.thathuboverthere.com/media/*",
      "zone_name": "thathuboverthere.com"
    },
    {
      "pattern": "public-profile-staging.thathuboverthere.com/media/*",
      "zone_name": "thathuboverthere.com"
    },
    {
      "pattern": "www.thathuboverthere.com/preview/*",
      "zone_name": "thathuboverthere.com"
    },
    {
      "pattern": "public-profile-staging.thathuboverthere.com/preview/*",
      "zone_name": "thathuboverthere.com"
    }
  ],
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "LIVE_PUBLIC_CREATOR_SLUGS": "adelaide"
  },
  "kv_namespaces": [
    {
      "binding": "PUBLIC_LINKS",
      "id": "34a4601e8bbb4d3bb05656bf1f59c2c1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "thot-os-public-media-staging"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
