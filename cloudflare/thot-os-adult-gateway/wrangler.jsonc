{
  "$schema": "../thot-os-next/node_modules/wrangler/config-schema.json",
  "name": "thot-os-adult-gateway-staging",
  "account_id": "3e7cfa6efb7a97825f1dc24515410c63",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "more-staging.thathuboverthere.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ADULT_PROFILES",
      "id": "960ce926cd234170aa789a8eb0ca223a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ADULT_MEDIA",
      "bucket_name": "thot-os-adult-media-staging"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ADULT_EVENTS",
      "dataset": "thot-os-adult-events-staging"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "REQUIRES_STAGING_TURNSTILE_SITE_KEY",
    "TURNSTILE_EXPECTED_HOSTNAME": "more-staging.thathuboverthere.com"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET", "AGE_SESSION_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
