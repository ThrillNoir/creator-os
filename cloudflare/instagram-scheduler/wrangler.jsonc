{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thot-os-instagram-scheduler-staging",
  "account_id": "3e7cfa6efb7a97825f1dc24515410c63",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["COMPOSIO_API_KEY", "COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID", "R2_VIDEO_UPLOAD_ACCESS_KEY_ID", "R2_VIDEO_UPLOAD_SECRET_ACCESS_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thot-os-staging",
      "database_id": "174532e8-5ada-4e30-abba-1276b3540b3f",
      "migrations_dir": "../thot-os-app/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PREVIEWS", "bucket_name": "thot-os-previews-staging" },
    { "binding": "LIBRARY_MEDIA", "bucket_name": "thot-os-library-media-staging" }
  ]
}
