// Source-only local template. It is not a deploy configuration and contains no
// live namespace IDs, routes, secrets, or hostnames.
{
  "$schema": "../thot-os-next/node_modules/wrangler/config-schema.json",
  "name": "thot-os-public-contact-local-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "CONTACT_PROFILES", "id": "LOCAL_CONTACT_PROFILES_ONLY" }],
  "analytics_engine_datasets": [{ "binding": "CONTACT_EVENTS", "dataset": "LOCAL_CONTACT_EVENTS_ONLY" }],
  "vars": {
    "TURNSTILE_SITE_KEY": "REQUIRES_LOCAL_VALUE",
    "TURNSTILE_EXPECTED_HOSTNAME": "localhost"
  },
  "secrets": { "required": ["TURNSTILE_SECRET"] }
}
