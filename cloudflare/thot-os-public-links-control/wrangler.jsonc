{
  "$schema": "../thot-os-next/node_modules/wrangler/config-schema.json",
  "name": "thot-os-public-links-control-staging",
  "account_id": "3e7cfa6efb7a97825f1dc24515410c63",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_PROFILE_PUBLICATION_MODE": "synthetic-only",
    "PUBLIC_PROFILE_SYNTHETIC_CREATOR_IDS": "staging-synthetic-creator,adelaide",
    "ADULT_PROFILE_PUBLICATION_MODE": "synthetic-only",
    "ADULT_PROFILE_SYNTHETIC_CREATOR_IDS": "adelaide",
    "PUBLIC_MEDIA_DELIVERY_ENABLED": "1",
    "PUBLIC_MEDIA_BASE_URL": "https://public-profile-staging.thathuboverthere.com",
    "ADULT_MEDIA_DELIVERY_ENABLED": "1",
    "ADULT_GATEWAY_BASE_URL": "https://more-staging.thathuboverthere.com",
    "SAFE_PUBLIC_PROFILE_BASE_URL": "https://public-profile-staging.thathuboverthere.com",
    "BOOKING_ACTION_BASE_URL": "https://booking-staging.thathuboverthere.com",
    "BOOKING_ENQUIRIES_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thot-os-staging",
      "database_id": "174532e8-5ada-4e30-abba-1276b3540b3f",
      "migrations_dir": "../thot-os-app/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PUBLIC_LINKS",
      "id": "34a4601e8bbb4d3bb05656bf1f59c2c1"
    },
    {
      "binding": "ADULT_PROFILES",
      "id": "960ce926cd234170aa789a8eb0ca223a"
    },
    {
      "binding": "CONTACT_PROFILES",
      "id": "57d716b2562b4bb989e62482df6f6b19"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "thot-os-media-staging"
    },
    {
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "thot-os-public-media-staging"
    },
    {
      "binding": "ADULT_MEDIA",
      "bucket_name": "thot-os-adult-media-staging"
    }
  ],
  "workflows": [
    {
      "name": "thot-os-public-profile-publish-staging",
      "binding": "PUBLIC_PROFILE_PUBLISH",
      "class_name": "PublicProfilePublishWorkflow"
    },
    {
      "name": "thot-os-public-profile-withdraw-staging",
      "binding": "PUBLIC_PROFILE_WITHDRAW",
      "class_name": "PublicProfileWithdrawWorkflow"
    },
    {
      "name": "thot-os-adult-profile-publish-staging",
      "binding": "ADULT_PROFILE_PUBLISH",
      "class_name": "AdultProfilePublishWorkflow"
    },
    {
      "name": "thot-os-adult-profile-withdraw-staging",
      "binding": "ADULT_PROFILE_WITHDRAW",
      "class_name": "AdultProfileWithdrawWorkflow"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["welcome@thathuboverthere.com"],
      "allowed_destination_addresses": ["suedeadelaide@gmail.com"]
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
